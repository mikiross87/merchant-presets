{
  "id": "merchant-presets",
  "title": "Merchant Presets — Shops for 5e",
  "description": "<p>Fifty-one ready-made shops as Item Piles merchants — seventeen stores in Village, Town and City sizes, each pre-stocked and priced.</p><p>Built entirely from <strong>SRD 5.2</strong> (CC-BY-4.0) plus this module's own goods for the services the books print as table rows rather than items, so it works in any dnd5e world and redistributes no paid content.</p><p>Inspired by The Inspired Arcana's free homebrew shop guide.</p>",
  "version": "1.1.0-dev",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Miguel Ross"
    }
  ],
  "url": "https://github.com/mikiross87/merchant-presets",
  "manifest": "https://github.com/mikiross87/merchant-presets/releases/latest/download/module.json",
  "download": "https://github.com/mikiross87/merchant-presets/releases/latest/download/module.zip",
  "license": "https://github.com/mikiross87/merchant-presets/blob/main/LICENSE",
  "readme": "https://github.com/mikiross87/merchant-presets/blob/main/README.md",
  "bugs": "https://github.com/mikiross87/merchant-presets/issues",
  "changelog": "https://github.com/mikiross87/merchant-presets/releases",
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.0.0",
          "verified": "5.3.3"
        }
      }
    ],
    "requires": [
      {
        "id": "item-piles",
        "type": "module",
        "compatibility": {
          "minimum": "3.2.7",
          "verified": "3.3.4"
        },
        "reason": "The merchants are Item Piles merchants; without it they are inert NPCs."
      },
      {
        "id": "itempilesdnd5e",
        "type": "module",
        "compatibility": {
          "minimum": "1.1.0",
          "verified": "1.1.0"
        },
        "reason": "Teaches Item Piles how dnd5e stores currency, prices and quantities."
      }
    ]
  },
  "packs": [
    {
      "name": "merchants",
      "label": "Merchants",
      "path": "packs/merchants",
      "type": "Actor",
      "system": "dnd5e",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "stock",
      "label": "Shop Stock Tables",
      "path": "packs/stock",
      "type": "RollTable",
      "system": "dnd5e"
    },
    {
      "name": "goods",
      "label": "Merchant Goods",
      "path": "packs/goods",
      "type": "Item",
      "system": "dnd5e"
    }
  ],
  "packFolders": [
    {
      "name": "Merchant Presets",
      "color": "#6b4f7d",
      "sorting": "m",
      "packs": [
        "merchants",
        "stock",
        "goods"
      ]
    }
  ],
  "esmodules": [
    "scripts/merchant-presets.mjs"
  ],
  "flags": {
    "hotReload": false
  }
}
