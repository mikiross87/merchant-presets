{{!-- The GM's Settings tab (#110), built to design v8ap9 (#145): one scrolling page, the nav
      jumping between its sections. `this` is shop-sheet.mjs's #settingsContext. Every control
      with a data-op edits on change (ShopSheet#_onSettingChange); buttons go through actions. --}}
{{#*inline "sectionHead"}}
  <div class="mp-section-head" data-pen="{{title}} head">
    <h2 class="mp-section-title" data-pen="{{title}} title">{{title}}</h2><span class="mp-rule" data-pen="{{title}} rule"></span>
  </div>
{{/inline}}
{{!-- A good as Players see shows it (design "Preview <name>"): `this` is #previewRow's. --}}
{{#*inline "previewRow"}}
  <div class="mp-preview-row" data-pen="Preview {{name}}">
    <img class="mp-preview-icon" data-pen="Item Icon" src="{{img}}" alt="" />
    <span class="mp-preview-text" data-pen="Text">
      <span class="mp-name-line" data-pen="Name line"><span data-pen="Name">{{name}}</span>{{#if isNew}}<span class="mp-new-badge" data-pen="New badge"><span data-pen="New badge text">{{localize "MERCHANT_PRESETS.Shop.Tag.New"}}</span></span>{{/if}}</span>
      {{#if showStock}}<span class="mp-meta {{#if metaDanger}}is-danger{{/if}}" data-pen="Meta">{{meta}}</span>{{/if}}
    </span>
    <span class="mp-price-block" data-pen="Price Block">
      {{#if listText}}<span class="mp-list-price" data-pen="List Price">{{listText}}</span>{{/if}}
      <span class="mp-price-line" data-pen="Price Line">
        {{#if tag.text}}<span class="mp-tag is-{{#if tag.tone}}{{tag.tone}}{{else}}good{{/if}}" data-pen="Terms Tag"><span data-pen="Terms Tag Text">{{tag.text}}</span></span>{{/if}}
        {{> mpCoins coins=priceCoins mode="price"}}
      </span>
    </span>
  </div>
{{/inline}}
{{!-- One of the shop's two rates: `side`, its `label`, and `rate` ({percent, word, worldDefault}). --}}
{{#*inline "rateRow"}}
  <div class="mp-rate-row" data-pen="Row {{label}}">
    <span class="mp-rate-label" data-pen="{{label}} label">{{label}}</span>
    <label class="mp-field" data-pen="Field {{rate.percent}}">
      <input type="text" inputmode="decimal" data-pen="Value" value="{{rate.percent}}" data-op="rate" data-side="{{side}}" {{disabled rate.worldDefault}} />
      <span data-pen="Suffix">%</span>
    </label>
    <em class="mp-plain" data-pen="{{label}} plain">{{rate.word}}</em>
    {{> check label=(localize "MERCHANT_PRESETS.Shop.Settings.Terms.WorldDefault") op="rateDefault" side=side checked=rate.worldDefault}}
  </div>
{{/inline}}
{{!-- One of the two things a restock can do (design "Option <title>"): a radio card. --}}
{{#*inline "restockOption"}}
  <label class="mp-option" data-pen="Option {{title}}">
    <input type="radio" class="mp-visually-hidden" name="restock-mode" value="{{value}}" data-op="mode" {{checked checked}} />
    <span class="mp-radio" data-pen="{{title}} radio"><span class="mp-radio-dot" data-pen="Dot"></span></span>
    <span class="mp-option-text" data-pen="{{title}} text">
      <b data-pen="{{title}} title">{{title}}</b>
      <span data-pen="{{title}} desc">{{desc}}</span>
    </span>
  </label>
{{/inline}}
{{!-- A checkbox with its label as an option (design "Check <label>", 13 px): `pen` names its box. --}}
{{#*inline "optionCheck"}}
  <label class="mp-check is-option {{#if dim}}mp-dim{{/if}}" data-pen="Check {{label}}">
    <input type="checkbox" class="mp-visually-hidden" data-op="{{op}}" {{#if list}}data-list="{{list}}" data-value="{{value}}"{{/if}} {{checked checked}} {{disabled dim}} />
    <span class="mp-box" data-pen="{{pen}} box">{{#if checked}}{{mpIcon "check" pen="Tick"}}{{/if}}</span><span data-pen="{{pen}} label">{{label}}</span>
  </label>
{{/inline}}
{{!-- Won't buy's two lists (design dYANz): a label, then the checks three to a row. --}}
{{#*inline "checkGrid"}}
  <span class="mp-how" data-pen="{{title}} label">{{title}}</span>
  <div class="mp-check-grid" data-pen="{{title}} grid">
    {{#each items}}
      <div class="mp-check-row" data-pen="{{../title}} row {{number}}">
        {{#each items}}{{> optionCheck label=label pen=label op="wontBuy" list=../../list value=value checked=checked}}{{/each}}
        {{#each fillers}}<span class="mp-check-filler" aria-hidden="true" data-pen="{{../../title}} filler"></span>{{/each}}
      </div>
    {{/each}}
  </div>
{{/inline}}
{{!-- An opening or closing time (design S2swP): the field, and what the hours come to. --}}
{{#*inline "hourRow"}}
  <div class="mp-rate-row {{#if dim}}mp-dim{{/if}}" data-pen="Row {{label}}">
    <span class="mp-rate-label" data-pen="{{label}} label">{{label}}</span>
    <label class="mp-field is-time" data-pen="Field {{value}}">
      <input type="time" data-pen="Value" value="{{value}}" data-op="hour" data-end="{{end}}" {{disabled dim}} />
      {{mpIcon "clock" pen="Clock"}}
    </label>
    {{#if plain}}<em class="mp-plain" data-pen="{{label}} plain">{{plain}}</em>{{/if}}
  </div>
{{/inline}}
{{!-- "Players can visit": atop the nav, or atop the form when the window is narrow (design bXBEW). --}}
{{#*inline "visitToggle"}}
  <label class="mp-visit {{class}}" data-pen="Visit toggle">
    <span class="mp-visit-row" data-pen="Visit row">
      <b data-pen="Visit label">{{localize "MERCHANT_PRESETS.Shop.Settings.Visit.Label"}}</b>
      <input type="checkbox" class="mp-visually-hidden" data-op="visit" {{checked visit}} />
      <span class="mp-switch" data-pen="Switch"><span class="mp-knob" data-pen="Knob"></span></span>
    </span>
    <span class="mp-visit-hint" data-pen="Visit hint">{{visitHint}}</span>
    {{#if visitOthers}}<span class="mp-visit-hint">{{localize "MERCHANT_PRESETS.Shop.Settings.Visit.Others" count=visitOthers}}</span>{{/if}}
  </label>
{{/inline}}
{{#*inline "check"}}
  <label class="mp-check" data-pen="Check {{label}}">
    <input type="checkbox" class="mp-visually-hidden" data-op="{{op}}" data-side="{{side}}" {{checked checked}} />
    <span class="mp-box" data-pen="Box">{{mpIcon "check" pen="Tick"}}</span><span data-pen="Check label">{{label}}</span>
  </label>
{{/inline}}

{{!-- A narrow window's way around (design bXBEW): the sections as a dropdown, like the categories. --}}
<div class="mp-category-bar mp-narrow-only" data-pen="Section bar">
  <label class="mp-category-select" data-pen="Section select">
    {{mpIcon activeSection.icon pen="Section icon"}}<span class="mp-cat-value" data-pen="Section value">{{activeSection.label}}</span>{{mpIcon "chevron-down" pen="Section chevron"}}
    <select class="mp-category-native mp-section-native" aria-label="{{activeSection.label}}">
      {{#each sections}}<option value="{{id}}" {{#if active}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </label>
</div>
<nav class="mp-section-nav mp-wide-only" data-pen="Section Nav">
  {{!-- A compendium preview (#199, design Zm5HK) reads its settings: nothing here writes, and
        whether players can visit is the world's own business. --}}
  {{#unless readOnly}}
  {{> visitToggle}}
  <span class="mp-visit-gap" data-pen="Visit gap"></span>
  {{/unless}}
  {{#each sections}}
    <button type="button" class="mp-nav-link {{#if active}}active{{/if}}" data-action="settingsSection" data-section="{{id}}" data-pen="Nav {{label}}">
      {{mpIcon icon pen=(concat label " icon")}}<span data-pen="{{label}} label">{{label}}</span>
    </button>
  {{/each}}
  <span class="mp-nav-spacer" data-pen="Nav spacer"></span>
  {{#unless readOnly}}
  <button type="button" class="mp-reset" data-action="resetToPreset" data-pen="Reset" {{disabled (not canReset)}}
    {{#unless canReset}}data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Settings.Reset.NoPreset'}}"{{/unless}}>
    {{mpIcon "rotate-ccw" pen="Reset icon"}}<span data-pen="Reset label">{{localize "MERCHANT_PRESETS.Shop.Settings.Reset.Label"}}</span>
  </button>
  {{/unless}}
</nav>

<div class="mp-form settings-body" data-pen="Form">
  {{#if readOnly}}
    <div class="mp-preview-notice" data-pen="Preview notice">{{mpIcon "book-open" pen="Notice icon"}}<span data-pen="Notice text">{{localize "MERCHANT_PRESETS.Shop.Preview.Settings"}}</span></div>
  {{else}}
    {{> visitToggle class="mp-narrow-only"}}
  {{/if}}
  {{#if broken}}<p class="settings-note">{{localize "MERCHANT_PRESETS.Shop.Settings.Broken"}}</p>{{/if}}

  <section class="settings-section" data-section="terms" data-pen="Section Terms">
    {{> sectionHead title=(localize "MERCHANT_PRESETS.Shop.Settings.Sections.terms")}}
    <p class="mp-hint" data-pen="Terms hint">{{localize "MERCHANT_PRESETS.Shop.Settings.Terms.Hint"}}</p>
    {{> rateRow side="sellsAt" label=(localize "MERCHANT_PRESETS.Shop.Settings.Terms.SellsAt") rate=terms.sells}}
    {{> rateRow side="buysAt" label=(localize "MERCHANT_PRESETS.Shop.Settings.Terms.BuysAt") rate=terms.buys}}
    <p class="mp-live-example" data-pen="Live example">
      {{mpIcon "lightbulb" pen="Example icon"}}<span data-pen="Example a">{{terms.example.text}}</span>
      {{> mpCoins coins=terms.example.sell mode="count"}}
      <span data-pen="Example b">{{localize "MERCHANT_PRESETS.Shop.Settings.Terms.ExampleBuys"}}</span>
      {{> mpCoins coins=terms.example.buy mode="count"}}
    </p>
    <div class="mp-rules" data-pen="Category rules">
      <span class="mp-rate-label" data-pen="Cat rules label">{{localize "MERCHANT_PRESETS.Shop.Settings.Rules.Title"}}</span>
      {{#unless terms.rules.length}}<span class="mp-rules-none" data-pen="Cat rules none">{{localize "MERCHANT_PRESETS.Shop.Settings.Rules.None"}}</span>{{/unless}}
      {{#if (and terms.ruleChoices.length (not readOnly))}}
        <button type="button" class="mp-button" data-action="addRule" data-pen="Add rule"><span data-pen="Label">{{localize "MERCHANT_PRESETS.Shop.Settings.Rules.Add"}}</span></button>
      {{/if}}
    </div>
    {{#each terms.rules}}
      <div class="settings-rule">
        <b>{{label}}</b>
        <span class="settings-percent">{{localize "MERCHANT_PRESETS.Shop.Settings.Rules.Sells"}}
          <input type="text" inputmode="decimal" value="{{sellsPercent}}" placeholder="{{sellsFollows}}" data-op="ruleRate" data-category="{{category}}" data-side="sellsAt" />%</span>
        <span class="settings-percent">{{localize "MERCHANT_PRESETS.Shop.Settings.Rules.Buys"}}
          <input type="text" inputmode="decimal" value="{{buysPercent}}" placeholder="{{buysFollows}}" data-op="ruleRate" data-category="{{category}}" data-side="buysAt" />%</span>
        {{#unless ../readOnly}}
        <button type="button" class="mp-icon-button" data-action="removeRule" data-category="{{category}}"
          data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Settings.Rules.Remove'}}" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Rules.Remove'}}">
          {{mpIcon "trash-2"}}
        </button>
        {{/unless}}
      </div>
    {{/each}}
  </section>

  <section class="settings-section" data-section="deals" data-pen="Section Deals">
    {{> sectionHead title=(localize "MERCHANT_PRESETS.Shop.Settings.Sections.deals")}}
    <p class="mp-hint" data-pen="Deals hint">{{localize "MERCHANT_PRESETS.Shop.Settings.Deals.Hint"}}</p>
    {{#each deals.list}}
      <div class="mp-deal {{#if ended}}is-ended{{/if}}" data-pen="Deal {{name}}">
        <span class="mp-deal-avatar" data-pen="{{name}} avatar" aria-hidden="true"><span data-pen="{{name}} initial">{{initial}}</span></span>
        <span class="mp-deal-text" data-pen="{{name}} text">
          <span class="mp-deal-line" data-pen="{{name}} line">
            <b data-pen="{{name}} name">{{name}}</b>
            {{#each badges}}<span class="mp-tag is-good" data-pen="{{../name}} tag"><span data-pen="{{../name}} tag text">{{this}}</span></span>{{/each}}
          </span>
          <span class="mp-deal-note" data-pen="{{name}} note">{{line}}</span>
        </span>
        {{#unless ../readOnly}}
        <button type="button" class="mp-icon-button" data-action="editDeal" data-actor="{{actor}}"
          data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Settings.Deals.Edit'}}" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Deals.Edit'}}">
          {{mpIcon "pencil" pen=(concat name " pencil")}}
        </button>
        <button type="button" class="mp-icon-button" data-action="removeDeal" data-actor="{{actor}}"
          data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Settings.Deals.Remove'}}" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Deals.Remove'}}">
          {{mpIcon "trash-2" pen=(concat name " trash-2")}}
        </button>
        {{/unless}}
      </div>
    {{else}}
      <p class="mp-hint" data-pen="Deals none">{{localize "MERCHANT_PRESETS.Shop.Settings.Deals.None"}}</p>
    {{/each}}
    <div class="mp-deals-foot" data-pen="Deals foot">
      <span class="mp-cap-note" data-pen="Cap note">{{localize "MERCHANT_PRESETS.Shop.Settings.Deals.Cap"}}</span>
      {{#unless readOnly}}<button type="button" class="mp-button" data-action="callHaggle" data-pen="Call haggle"><span data-pen="Label">{{localize "MERCHANT_PRESETS.Shop.Settings.Deals.Call"}}</span></button>{{/unless}}
      {{#unless readOnly}}<button type="button" class="mp-button" data-action="addDeal" data-pen="Add deal"><span data-pen="Label">{{localize "MERCHANT_PRESETS.Shop.Settings.Deals.Add"}}</span></button>{{/unless}}
    </div>
  </section>

  <section class="settings-section" data-section="wontBuy" data-pen="Section Won't buy">
    {{> sectionHead title=(localize "MERCHANT_PRESETS.Shop.Settings.Sections.wontBuy")}}
    <p class="mp-hint" data-pen="Won't buy hint">{{localize "MERCHANT_PRESETS.Shop.Settings.WontBuy.Hint"}}</p>
    {{> checkGrid title=(localize "MERCHANT_PRESETS.Shop.Settings.WontBuy.Types") list="types" items=wontBuy.types}}
    {{> checkGrid title=(localize "MERCHANT_PRESETS.Shop.Settings.WontBuy.Kinds") list="kinds" items=wontBuy.kinds}}
  </section>

  <section class="settings-section" data-section="hours" data-pen="Section Hours">
    {{> sectionHead title=(localize "MERCHANT_PRESETS.Shop.Settings.Sections.hours")}}
    {{!-- Where shops don't follow the world clock (#149, design RRqQ7) the hint says so, and the
          controls stay in view but dimmed and disabled. --}}
    {{#if hours.noClock}}
      <p class="mp-hint" data-pen="Hours hint">{{localize "MERCHANT_PRESETS.Shop.Settings.Hours.NoClock"}}</p>
    {{else}}
      <p class="mp-hint" data-pen="Hours hint">{{localize "MERCHANT_PRESETS.Shop.Settings.Hours.Hint"}}</p>
      {{#if hours.worldOff}}<p class="settings-note">{{localize "MERCHANT_PRESETS.Shop.Settings.Hours.WorldOff"}}</p>{{/if}}
    {{/if}}
    {{> optionCheck label=(localize "MERCHANT_PRESETS.Shop.Settings.Hours.Keeps") pen="Keeps" op="keepHours" checked=hours.keeps dim=hours.noClock}}
    {{#if hours.keeps}}
      {{> hourRow label=(localize "MERCHANT_PRESETS.Shop.Settings.Hours.Opens") end="open" value=hours.open dim=hours.noClock}}
      {{> hourRow label=(localize "MERCHANT_PRESETS.Shop.Settings.Hours.Closes") end="close" value=hours.close plain=hours.length dim=hours.noClock}}
      <p class="mp-hint {{#if hours.noClock}}mp-dim{{/if}}" data-pen="Hours note">{{localize "MERCHANT_PRESETS.Shop.Settings.Hours.Note"}}</p>
    {{else}}
      <p class="mp-hint {{#if hours.noClock}}mp-dim{{/if}}" data-pen="Hours note">{{localize "MERCHANT_PRESETS.Shop.Settings.Hours.AlwaysOpen"}}</p>
    {{/if}}
  </section>

  <section class="settings-section" data-section="restock" data-pen="Section Restock">
    {{> sectionHead title=(localize "MERCHANT_PRESETS.Shop.Settings.Sections.restock")}}
    {{#if restock.noClock}}
      <p class="mp-hint" data-pen="Restock hint">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.NoClock"}}</p>
    {{else}}
      <p class="mp-hint" data-pen="Restock hint">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.Hint"}}</p>
      {{#if restock.autoOff}}<p class="settings-note">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.WorldOff"}}</p>{{/if}}
    {{/if}}
    {{!-- The stock table (design GfO9j): Change picks another, a RollTable dropped on the section
          becomes it (#190), Reset puts the preset's back, and the icon opens it. --}}
    <div class="mp-table-card" data-pen="Table card">
      {{mpIcon "dices" pen="Table icon"}}
      <span class="mp-table-text" data-pen="Table text">
        {{#if restock.table}}
          <b data-pen="Table name">{{restock.table.name}}</b>
          <span data-pen="Table meta">{{restock.table.meta}}</span>
        {{else}}
          <b data-pen="Table name">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.NoTableName"}}</b>
          <span data-pen="Table meta">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.NoTable"}}</span>
        {{/if}}
      </span>
      {{#unless readOnly}}
        <label class="mp-select mp-table-change" data-pen="Table change">
          <span class="mp-select-value" data-pen="Change text">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.Change"}}</span>{{mpIcon "chevron-down" pen="Change chevron"}}
          <select class="mp-select-native" data-op="table" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Restock.ChangeLabel'}}">
            {{#unless restock.table}}<option value="" selected></option>{{/unless}}
            {{#each restock.tables}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select>
        </label>
        {{#if restock.canResetTable}}
          <button type="button" class="mp-table-reset" data-action="resetTable" data-pen="Table reset" data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Settings.Restock.ResetTableHint'}}">
            {{mpIcon "rotate-ccw" pen="Reset icon"}}<span data-pen="Reset text">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.ResetTable"}}</span>
          </button>
        {{/if}}
      {{/unless}}
      {{#if restock.table}}
        <button type="button" class="mp-table-open" data-action="openTable" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Restock.OpenTable'}}">{{mpIcon "external-link" pen="Table open"}}</button>
      {{/if}}
    </div>
    {{#if restock.table}}
      {{!-- How many a restock stocks of each line (#190, design HKGIx). --}}
      <div class="mp-quantities" data-pen="Quantities">
        <span class="mp-how" data-pen="Quantities label">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.Quantities"}}</span>
        <div class="mp-schedule-row" data-pen="New lines row">
          <span class="mp-rate-label" data-pen="New lines label">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.NewLines"}}</span>
          <label class="mp-field {{#if restock.newLinesRefused}}is-refused{{/if}}" data-pen="Field New lines">
            <input type="text" data-pen="Value" value="{{restock.newLines}}" placeholder="1" data-op="defaultQuantity" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Restock.NewLines'}}" {{#if restock.newLinesRefused}}aria-invalid="true"{{/if}} />
          </label>
          <em class="mp-plain" data-pen="New lines plain">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.NewLinesPlain"}}</em>
        </div>
        {{!-- A formula that doesn't roll stays as typed, and says why (#229 review, design U9Jt8Z). --}}
        {{#if restock.newLinesRefused}}
          <div class="mp-refused is-new-lines" data-pen="New lines error"><span data-pen="New lines error text" role="alert">{{restock.newLinesRefused}}</span></div>
        {{/if}}
        <div class="mp-quantity-list" data-pen="Quantity list">
          <label class="mp-quantity-find" data-pen="Find row">
            {{mpIcon "search" pen="Find icon"}}
            <input type="search" data-pen="Find text" value="{{restock.find}}" data-op="findGood" placeholder="{{localize 'MERCHANT_PRESETS.Shop.Settings.Restock.Find'}}" />
          </label>
          <div class="mp-quantity-rule" data-pen="Find rule"></div>
          <div class="mp-quantity-rows">
            {{#each restock.quantities}}
              <div class="mp-quantity-row {{#if alt}}is-alt{{/if}}" data-pen="Line {{name}}" data-name="{{key}}">
                <span data-pen="{{name}} name">{{name}}</span>
                <label class="mp-field {{#if refused}}is-refused{{/if}}" data-pen="{{name}} field">
                  <input type="text" data-pen="{{name}} formula" value="{{value}}" placeholder="{{placeholder}}" data-op="quantity" data-id="{{id}}" aria-label="{{name}}" {{#if refused}}aria-invalid="true"{{/if}} />
                </label>
              </div>
              {{#if refused}}
                <div class="mp-refused is-line {{#if alt}}is-alt{{/if}}" data-pen="{{name}} error" data-name="{{key}}"><span data-pen="{{name}} error text" role="alert">{{refused}}</span></div>
              {{/if}}
            {{/each}}
          </div>
        </div>
      </div>
    {{/if}}
    <div class="mp-schedule {{#if restock.noClock}}mp-dim{{/if}}" data-pen="Schedule">
      <div class="mp-schedule-row" data-pen="Schedule row">
        <span class="mp-rate-label" data-pen="Schedule label">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.Restocks"}}</span>
        <label class="mp-select" data-pen="Schedule select">
          <span class="mp-select-value" data-pen="Schedule value">{{restock.current}}</span>{{mpIcon "chevron-down" pen="Schedule chevron"}}
          <select class="mp-select-native" data-op="everyChoice" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Restock.Restocks'}}" {{disabled restock.noClock}}>
            {{#each restock.chips}}<option value="{{id}}" {{#if active}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <em class="mp-plain" data-pen="Schedule when">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.WhenOpens"}}</em>
      </div>
      <div class="mp-pills" data-pen="Schedule pills">
        {{#each restock.chips}}
          <button type="button" class="mp-pill {{#if active}}active{{/if}}" data-action="setEvery" data-every="{{id}}" data-pen="Pill {{label}}" {{disabled ../restock.noClock}}><span data-pen="{{label}} text">{{label}}</span></button>
        {{/each}}
      </div>
      {{#if restock.showFormula}}
        <label class="settings-line">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.Formula"}}
          <input type="text" class="settings-formula {{#if restock.formulaRefused}}is-refused{{/if}}" value="{{restock.formula}}" placeholder="1d4+2" data-op="every" {{disabled restock.noClock}} {{#if restock.formulaRefused}}aria-invalid="true"{{/if}} /></label>
        {{#if restock.formulaRefused}}<p class="mp-refused" role="alert">{{restock.formulaRefused}}</p>{{/if}}
      {{/if}}
      {{#if restock.presetLine}}<p class="mp-hint" data-pen="Schedule default">{{restock.presetLine}}</p>{{/if}}
    </div>
    <span class="mp-how" data-pen="How label">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.What"}}</span>
    {{> restockOption value="reroll" checked=restock.reroll title=(localize "MERCHANT_PRESETS.Shop.Settings.Restock.Reroll") desc=(localize "MERCHANT_PRESETS.Shop.Settings.Restock.RerollHint")}}
    {{> restockOption value="topup" checked=(not restock.reroll) title=(localize "MERCHANT_PRESETS.Shop.Settings.Restock.Topup") desc=(localize "MERCHANT_PRESETS.Shop.Settings.Restock.TopupHint")}}
    {{#if restock.purseGp}}
      <p class="mp-hint mp-till-note" data-pen="Till note">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.Till" gp=restock.purseGp}}</p>
    {{/if}}
    <div class="mp-last-row" data-pen="Last row">
      <div class="mp-last-text" data-pen="Last text">
        {{#if restock.noClock}}
          <span class="mp-last-line" data-pen="Last line">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.ByHand"}}</span>
        {{else}}
          {{#if restock.last}}<span class="mp-last-line" data-pen="Last line">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.Last" date=restock.last}}</span>{{/if}}
          {{#if restock.next}}<span class="mp-hint" data-pen="Next line">{{restock.next}}</span>{{/if}}
        {{/if}}
      </div>
      {{#unless readOnly}}
      <button type="button" class="mp-restock-now" data-action="restockNow" data-pen="Restock now" {{disabled (not restock.table)}}>
        {{mpIcon "refresh-cw" pen="Icon"}}<span data-pen="Label">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.Now"}}</span>
      </button>
      {{/unless}}
    </div>
  </section>

  {{!-- Other customers (#226, design GVLI3; off, E6jfnh): the world's level, today's kind of day
        and its override, and the busy-day table it rolls on. --}}
  <section class="settings-section" data-section="customers" data-pen="Section Customers">
    {{> sectionHead title=(localize "MERCHANT_PRESETS.Shop.Settings.Sections.customers")}}
    <p class="mp-hint" data-pen="Customers hint">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.Hint"}}</p>
    <div class="mp-rate-row" data-pen="Row World">
      <span class="mp-rate-label" data-pen="World label">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.World"}}</span>
      <span class="mp-world-value" data-pen="World value">
        <b data-pen="World level">{{customers.levelName}}</b>
        <span data-pen="World plain">{{#if customers.off}}{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.WorldOff"}}{{else}}{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.WorldOn"}}{{/if}}</span>
      </span>
    </div>
    <div class="mp-today-card" data-pen="Today card">
      {{#if customers.off}}
        <p class="mp-today-text" data-pen="Off text">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.OffText"}}</p>
      {{else}}
        <span class="mp-till-kicker" data-pen="Today kicker">{{customers.today.kicker}}</span>
        <span class="mp-today-title" data-pen="Today title row">
          <b data-pen="Today name">{{customers.today.name}}</b>
          {{#if customers.today.trade}}<span data-pen="Today trade">{{customers.today.trade}}</span>{{/if}}
        </span>
        <p class="mp-today-text" data-pen="Today text">{{customers.today.text}}</p>
        <span class="mp-today-meta" data-pen="Today meta">{{customers.today.meta}}</span>
      {{/if}}
    </div>
    {{#unless customers.off}}
      <div class="mp-rate-row" data-pen="Row Today">
        <span class="mp-rate-label" data-pen="Today label">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.Today"}}</span>
        <label class="mp-select mp-today-select" data-pen="Today select">
          <span class="mp-select-value" data-pen="Today value">{{customers.choice}}</span>{{mpIcon "chevron-down" pen="Today chevron"}}
          <select class="mp-select-native" data-op="customersDay" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Customers.TodayLabel'}}" {{disabled readOnly}}>
            <option value="" {{#unless customers.overridden}}selected{{/unless}}>{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.AsRolled"}}</option>
            {{#each customers.days}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select>
        </label>
        <span class="mp-today-plain" data-pen="Today plain">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.TodayPlain"}}</span>
      </div>
      <span class="mp-how" data-pen="Days label">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.DaysRollOn"}}</span>
      {{!-- As the stock table's card (design GfO9j): Change picks another, a RollTable dropped on the
            section becomes it, Reset puts the shipped one back, and the icon opens it. --}}
      <div class="mp-table-card" data-pen="Table card">
        {{mpIcon "dices" pen="Table icon"}}
        <span class="mp-table-text" data-pen="Table text">
          {{#if customers.table}}
            <b data-pen="Table name">{{customers.table.name}}</b>
            <span data-pen="Table meta">{{customers.table.meta}}</span>
          {{else}}
            <b data-pen="Table name">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.NoTableName"}}</b>
            <span data-pen="Table meta">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.NoTable"}}</span>
          {{/if}}
        </span>
        {{#unless readOnly}}
          <label class="mp-select mp-table-change" data-pen="Table change">
            <span class="mp-select-value" data-pen="Change text">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.Change"}}</span>{{mpIcon "chevron-down" pen="Change chevron"}}
            <select class="mp-select-native" data-op="customersTable" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Customers.ChangeLabel'}}">
              {{#unless customers.table}}<option value="" selected></option>{{/unless}}
              {{#each customers.tables}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
            </select>
          </label>
          {{#if customers.canResetTable}}
            <button type="button" class="mp-table-reset" data-action="resetCustomersTable" data-pen="Table reset" data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Settings.Customers.ResetTableHint'}}">
              {{mpIcon "rotate-ccw" pen="Reset icon"}}<span data-pen="Reset text">{{localize "MERCHANT_PRESETS.Shop.Settings.Restock.ResetTable"}}</span>
            </button>
          {{/if}}
        {{/unless}}
        {{#if customers.table}}
          <button type="button" class="mp-table-open" data-action="openCustomersTable" data-pen="Table open" aria-label="{{customers.table.name}}">{{mpIcon "external-link" pen="Table open"}}</button>
        {{/if}}
      </div>
      <p class="mp-hint mp-customers-note" data-pen="Customers note">{{localize "MERCHANT_PRESETS.Shop.Settings.Customers.Note"}}</p>
    {{/unless}}
  </section>

  {{!-- The last section, on a page-tall wrapper: jumped to, it scrolls to the top (design U0HcWc). --}}
  <div class="mp-form-last">
  <section class="settings-section" data-section="till" data-pen="Section Till">
    {{> sectionHead title=(localize "MERCHANT_PRESETS.Shop.Settings.Sections.till")}}
    {{!-- Under unlimited merchant coin (design Yusa2) the till is bottomless: a note, the fields dimmed and disabled. --}}
    <p class="mp-hint" data-pen="Till hint">{{#if till.unlimited}}{{localize "MERCHANT_PRESETS.Shop.Settings.Till.Unlimited"}}{{else}}{{localize "MERCHANT_PRESETS.Shop.Settings.Till.Hint"}}{{/if}}</p>
    <div class="mp-rate-row {{#if till.unlimited}}mp-dim{{/if}}" data-pen="Row Holds">
      <span class="mp-rate-label" data-pen="Holds label">{{localize "MERCHANT_PRESETS.Shop.Settings.Till.Holds"}}</span>
      <div class="mp-coin-fields" data-pen="Coin fields">
        {{#each till.coins}}
          <label class="mp-field is-coin" data-pen="Field {{mpCoinPen 'metal' this}}">
            <input type="text" inputmode="numeric" data-pen="Value" value="{{count}}" data-op="till" data-denomination="{{denomination}}" aria-label="{{aria}}" {{disabled ../till.unlimited}} />
            <img data-pen="Coin" src="{{icon}}" alt="" />
          </label>
        {{/each}}
      </div>
    </div>
    {{#if till.gold}}
      <div class="mp-rate-row {{#if till.unlimited}}mp-dim{{/if}}" data-pen="Row Refills to">
        <span class="mp-rate-label" data-pen="Refills to label">{{localize "MERCHANT_PRESETS.Shop.Settings.Till.RefillsTo"}}</span>
        <label class="mp-field is-coin" data-pen="Field Refill gold">
          <input type="text" inputmode="numeric" data-pen="Value" value="{{till.purseGp}}" data-op="purse" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Till.RefillsTo'}}" {{disabled till.unlimited}} />
          <img data-pen="Coin" src="{{till.gold.icon}}" alt="" />
        </label>
        <em class="mp-plain" data-pen="Refills plain">{{#if till.presetGp includeZero=true}}{{localize "MERCHANT_PRESETS.Shop.Settings.Till.EachRestockPreset" gp=till.presetGp}}{{else}}{{localize "MERCHANT_PRESETS.Shop.Settings.Till.EachRestock"}}{{/if}}</em>
      </div>
    {{/if}}
    <p class="mp-hint {{#if till.unlimited}}mp-dim{{/if}}" data-pen="Till note">{{localize "MERCHANT_PRESETS.Shop.Settings.Till.Note"}}</p>
  </section>
  {{!-- The nav's reset, for a narrow window, which hides the nav. --}}
  {{#unless readOnly}}
  <button type="button" class="mp-reset mp-narrow-only" data-action="resetToPreset" {{disabled (not canReset)}}>
    {{mpIcon "rotate-ccw"}}<span>{{localize "MERCHANT_PRESETS.Shop.Settings.Reset.Label"}}</span>
  </button>
  {{/unless}}
  </div>
</div>

<aside class="mp-players-see settings-preview mp-wide-only" data-pen="Players See">
  <div class="mp-preview-head" data-pen="Preview head">
    {{mpIcon "eye" pen="Eye"}}<h2 class="mp-section-title" data-pen="Preview title">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.Title"}}</h2>
  </div>
  {{#if preview.wontBuy}}
    <span class="mp-kicker" data-pen="Sell tab label">{{preview.wontBuy.label}}</span>
    {{#each preview.wontBuy.rows}}{{> previewRow this showStock=true}}{{/each}}
    <p class="mp-preview-foot" data-pen="Preview foot">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.WontBuyNote"}}</p>
  {{else if preview.hours}}
    {{#each preview.hours.samples}}
      <span class="mp-kicker" data-pen="{{pen}} label">{{label}}</span>
      <span class="mp-chip is-{{state}}" data-pen="Chip {{chip}}"><span class="mp-chip-dot" data-pen="{{chip}} dot"></span><span data-pen="{{chip}} text">{{chip}}</span></span>
    {{/each}}
    <p class="mp-preview-foot" data-pen="Preview foot">{{#if preview.hours.noClock}}{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.NoClock"}}{{else}}{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.HoursNote"}}{{/if}}</p>
  {{else if preview.till}}
    {{!-- The Sell tab's till card, with no bill on it (design U0HcWc); none under unlimited coin (Yusa2). --}}
    {{#if preview.till.card}}
      <span class="mp-kicker" data-pen="Sell label">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.OnSellTab"}}</span>
      <div class="mp-till-card" data-pen="Till Card">
        <span class="mp-till-kicker" data-pen="Till kicker">{{localize "MERCHANT_PRESETS.Shop.Sell.Till"}}</span>
        <div class="mp-till-coins" data-pen="Till coins">{{> mpCoins coins=preview.till.card.coins mode="count"}}</div>
        <span class="mp-meter" data-pen="Till meter"></span>
        <p class="mp-till-note" data-pen="Till note">{{localize "MERCHANT_PRESETS.Shop.Sell.TillNote"}}</p>
      </div>
      <p class="mp-preview-foot" data-pen="Preview foot">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.TillNote"}}</p>
    {{else}}
      <p class="mp-preview-foot" data-pen="Preview foot">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.TillUnlimited"}}</p>
    {{/if}}
  {{else if preview.customers}}
    {{!-- The hero's day chip as players get it, with its line as on hover (design GVLI3); nothing while off (E6jfnh). --}}
    {{#if preview.customers.off}}
      <span class="mp-kicker" data-pen="Header label">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.Nothing"}}</span>
      <p class="mp-preview-foot" data-pen="Preview foot">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.CustomersOff"}}</p>
    {{else if preview.customers.day}}
      <span class="mp-kicker" data-pen="Header label">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.InHeader"}}</span>
      <div class="mp-day-preview" data-pen="Day preview">
        <div class="mp-day-strip" data-pen="Header strip">
          <span class="mp-hero-chip mp-day-chip" data-pen="Day Chip">{{mpIcon "users" pen="Day icon"}}<span data-pen="Day Label">{{preview.customers.day.name}}</span></span>
        </div>
        <div class="mp-day-tip" data-pen="Day tip"><span data-pen="Day tip text">{{preview.customers.day.text}}</span></div>
      </div>
      <p class="mp-preview-foot" data-pen="Preview foot">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.CustomersNote"}}</p>
    {{else}}
      <span class="mp-kicker" data-pen="Header label">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.InHeader"}}</span>
      <p class="mp-preview-foot" data-pen="Preview foot">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.CustomersNotYet"}}</p>
    {{/if}}
  {{else if preview.restock}}
    <span class="mp-kicker" data-pen="After label">{{preview.restock.label}}</span>
    <span class="mp-chip" data-pen="Fresh chip">{{mpIcon "sparkles" pen="Fresh icon"}}<span data-pen="Fresh text">{{localize "MERCHANT_PRESETS.Shop.FreshStockToday"}}</span></span>
    {{#each preview.restock.rows}}{{> previewRow this showStock=true}}{{/each}}
    <p class="mp-preview-foot" data-pen="Preview foot">{{preview.restock.note}}</p>
  {{else}}
    <span class="mp-kicker" data-pen="Everyone label">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.Everyone"}}</span>
    <span class="mp-chip" data-pen="Chip {{preview.chip}}">{{mpIcon "scale" pen="Chip icon"}}<span data-pen="Chip text">{{preview.chip}}</span></span>
    {{#if preview.item}}{{> previewRow preview.item}}{{/if}}
    {{#each preview.deals}}
      <hr class="mp-divider" data-pen="Preview divider" />
      <span class="mp-kicker" data-pen="{{name}} label">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.Only" name=name}}</span>
      <span class="mp-chip" data-pen="Chip {{chip}}">{{mpIcon "scale" pen="Chip icon"}}<span data-pen="Chip text">{{chip}}</span></span>
      {{#if item}}{{> previewRow item}}{{/if}}
    {{/each}}
    <p class="mp-preview-foot" data-pen="Preview foot">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.Note"}}</p>
  {{/if}}
</aside>
{{!-- A narrow window docks Players see at the bottom, like the bill (design bXBEW); the chevron shows it in place of the form. --}}
<div class="mp-dock mp-preview-dock mp-narrow-only" data-pen="Preview dock">
  <div class="mp-grip-row" data-pen="Grip row"><span class="mp-grip" data-pen="Grip"></span></div>
  <div class="mp-dock-summary" data-pen="Preview summary">
    <div class="mp-dock-text" data-pen="Preview text">
      <span class="mp-slip-kicker" data-pen="Preview kicker">{{localize "MERCHANT_PRESETS.Shop.Settings.Preview.Title"}}</span>
      <span class="mp-dock-lines" data-pen="Preview line">{{preview.line}}</span>
    </div>
    <button type="button" class="mp-dock-expand" data-action="togglePreview" aria-label="{{localize 'MERCHANT_PRESETS.Shop.Settings.Preview.Title'}}">
      {{#if previewOpen}}{{mpIcon "chevron-down" pen="Collapse"}}{{else}}{{mpIcon "chevron-up" pen="Expand"}}{{/if}}
    </button>
  </div>
</div>
