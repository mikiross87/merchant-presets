{{!-- One row of the Buyer Picker popover (design/README.md, "Buying as"). `this` is one
      buyerPicker entry {id, uuid, name, img, subtitle, purse, hasPurse, current}. Picking one
      closes the picker in ShopSheet's own pickBuyer action. --}}
{{!-- Redeclared per-file (matches shop-sheet.hbs's own "coins" inline) rather than assumed
      visible across a partial-file boundary — Handlebars inline-partial scoping through a
      separately-loaded `{{> "path"}}` include isn't worth gambling on. --}}
{{#*inline "coins"}}
  {{#each this}}
    <span class="coin coin-{{denomination}}" data-tooltip="{{aria}}" aria-label="{{aria}}">
      <img src="{{icon}}" alt="" /><b>{{count}}</b>
    </span>
  {{else}}
    <span class="coin coin-free">{{localize "MERCHANT_PRESETS.Shop.Free"}}</span>
  {{/each}}
{{/inline}}
<button type="button" class="buyer-entry {{#if current}}is-current{{/if}} {{#unless hasPurse}}is-dimmed{{/unless}}"
  data-action="pickBuyer" data-actor-uuid="{{uuid}}">
  <img class="buyer-entry-img" src="{{img}}" alt="" />
  <span class="buyer-entry-info">
    <span class="buyer-entry-name">{{name}}</span>
    <span class="buyer-entry-subtitle">
      {{#if subtitle}}{{subtitle}} · {{/if}}
      {{#if hasPurse}}<span class="buyer-entry-purse">{{> coins purse}}</span>{{else}}{{localize "MERCHANT_PRESETS.Shop.NoPurse"}}{{/if}}
    </span>
  </span>
  {{#if current}}<i class="fa-solid fa-check buyer-entry-check" aria-hidden="true"></i>{{/if}}
</button>
