{{!-- The shop window (#103), built to design/shop.pen's frames (#145): every element the design
      draws carries its layer name as `data-pen`, which tools/design-check.mjs pairs with the
      frame's node of that name. One root template: every tab's markup is always in the DOM (see
      shop-sheet.mjs's _prepareContext comment), and core's native changeTab() toggles which
      .tab[data-tab] section is visible. --}}

{{!-- A tab's category links (the Buy and Sell navs): `categories` from the sheet, `kind` the tab. --}}
{{#*inline "mpCategoryLinks"}}
  {{#each categories}}
    <button type="button" class="mp-nav-link {{#if active}}active{{/if}}" data-action="selectCategory" data-kind="{{../kind}}" data-category="{{id}}" data-pen="Cat {{pen}}">
      {{mpIcon icon pen=(concat pen " icon")}}<span class="mp-nav-label" data-pen="{{pen}} label">{{label}}</span><span class="mp-nav-count" data-pen="{{pen}} count">{{count}}</span>
    </button>
  {{/each}}
{{/inline}}
{{!-- The design's coins: `coins` a coinBreakdown() array, `mode` how each is named (mpCoinPen). --}}
{{#*inline "mpCoins"}}
  {{#each coins}}
    <span class="mp-coin coin-{{denomination}}" data-pen="{{mpCoinPen ../mode this @index}}" data-tooltip="{{aria}}" aria-label="{{aria}}">
      <b data-pen="Amount">{{count}}</b><img data-pen="Coin" src="{{icon}}" alt="" />
    </span>
  {{else}}
    <span class="mp-coin" data-pen="{{#if (eq mode 'price')}}Price{{else}}Free{{/if}}"><b class="is-free" data-pen="Amount">{{localize "MERCHANT_PRESETS.Shop.Free"}}</b></span>
  {{/each}}
{{/inline}}

<header class="mp-hero" data-pen="Hero">
  <img class="mp-portrait" data-pen="Merchant Portrait" src="{{header.img}}" alt="" />
  <div class="mp-identity" data-pen="Identity">
    <div class="mp-title-line" data-pen="Title line">
      <h1 class="mp-shop-name" data-pen="Shop Name">{{header.title}}</h1>
      {{#if header.fresh}}
        <span class="mp-hero-chip mp-fresh-chip" data-pen="Fresh Chip">{{mpIcon "sparkles" pen="Fresh icon"}}<span data-pen="Fresh label">{{localize "MERCHANT_PRESETS.Shop.FreshStockToday"}}</span></span>
      {{/if}}
    </div>
    {{!-- The shop's own #98 description; shipped shops carry it as HTML (a <p> of its own), so
          this renders it unescaped, after the sheet has run it through foundry.utils.cleanHTML. --}}
    <div class="mp-description" data-pen="Shop Description">{{{header.description}}}</div>
    <div class="mp-chips" data-pen="Chips">
      <span class="mp-hero-chip mp-open-chip {{#if header.open}}is-open{{else}}is-closed{{/if}}" data-pen="Open Chip">
        <span class="mp-dot" data-pen="Dot"></span><span data-pen="Open Label">{{header.openLabel}}</span>
      </span>
      <span class="mp-hero-chip" data-pen="Kind Chip">
        {{mpIcon header.kindIcon pen="Kind icon"}}<span data-pen="Kind Label">{{header.tier}}</span>
      </span>
      <button type="button" class="mp-hero-chip mp-terms-chip chip-terms" data-pen="Terms Chip" popovertarget="{{appId}}-terms-popover" style="anchor-name: --{{appId}}-terms">
        {{mpIcon "scale" pen="Terms icon"}}<span data-pen="Terms Label">{{header.termsChip}}</span>{{mpIcon "chevron-down" pen="Terms chevron"}}
      </button>
    </div>
  </div>
  <div class="mp-purse" data-pen="Purse">
    <span class="mp-purse-label" data-pen="Purse Label">{{localize "MERCHANT_PRESETS.Shop.BuyingAs"}}</span>
    <button type="button" class="mp-buyer-row buying-as-toggle" data-pen="Buyer row" popovertarget="{{appId}}-buyer-picker" style="anchor-name: --{{appId}}-buyer">
      {{#if buyer}}<span class="mp-buyer-avatar" data-pen="Buyer avatar"><span data-pen="Buyer initial">{{buyerInitial}}</span></span>{{/if}}
      <span class="mp-buyer-name" data-pen="Buyer name">{{#if buyer}}{{buyer.name}}{{else}}{{localize "MERCHANT_PRESETS.Shop.NoBuyer"}}{{/if}}</span>
      {{mpIcon "chevron-down" pen="Buyer chevron"}}
    </button>
    {{#if buyer}}
      <div class="mp-purse-coins" data-pen="Purse Coins">{{> mpCoins coins=buyerPurse mode="metal"}}</div>
    {{/if}}
  </div>
</header>

{{!-- Anchored under its chip (the chip names the anchor, per window). --}}
<div id="{{appId}}-terms-popover" popover class="mp-terms-popover" style="position-anchor: --{{appId}}-terms">
  <div class="mp-tp-head" data-pen="TP Head">{{mpIcon "scale" pen="TP icon"}}<h2 class="mp-tp-title" data-pen="TP Title">{{localize "MERCHANT_PRESETS.Shop.Terms.Title"}}</h2></div>
  {{#each header.terms.rows}}
    <div class="mp-term" data-pen="Term {{pen}}">
      {{mpIcon icon pen=(concat pen " icon")}}
      <div class="mp-term-text" data-pen="{{pen}} text">
        <span class="mp-term-line" data-pen="{{pen}} line"><span class="mp-term-key" data-pen="{{pen}} key">{{key}}</span><b class="mp-term-value" data-pen="{{pen}} value">{{value}}</b></span>
        {{#if detail}}<span class="mp-term-detail" data-pen="{{pen}} detail">{{detail}}</span>{{/if}}
      </div>
    </div>
  {{/each}}
  <p class="mp-tp-foot" data-pen="TP Foot">{{localize "MERCHANT_PRESETS.Shop.Terms.Note"}}</p>
</div>

{{!-- Anchored under the Buying as row, as the Terms popover is under its chip. --}}
<div id="{{appId}}-buyer-picker" popover class="mp-picker buyer-picker" style="position-anchor: --{{appId}}-buyer"
  data-pen="{{#if buyerPicker.gm}}Menu GM{{else}}Menu Player{{/if}}">
  {{#if buyerPicker.gm}}
    <label class="mp-picker-search" data-pen="Search">
      {{mpIcon "search" pen="Search icon"}}
      <input type="search" class="buyer-search" id="{{appId}}-buyer-search" data-pen="Search text" placeholder="{{localize 'MERCHANT_PRESETS.Shop.BuyerPicker.Search'}}" />
    </label>
    {{#if buyerPicker.characters.length}}
      <div class="mp-picker-group" data-pen="Group PLAYER CHARACTERS"><span data-pen="Group PLAYER CHARACTERS">{{localize "MERCHANT_PRESETS.Shop.BuyerPicker.PlayerCharacters"}}</span></div>
      {{#each buyerPicker.characters}}{{> "modules/merchant-presets/templates/parts/buyer-entry.hbs" this}}{{/each}}
    {{/if}}
    {{#if buyerPicker.others.length}}
      <div class="mp-picker-group" data-pen="Group OTHER ACTORS"><span data-pen="Group OTHER ACTORS">{{localize "MERCHANT_PRESETS.Shop.BuyerPicker.OtherActors"}}</span></div>
      {{#each buyerPicker.others}}{{> "modules/merchant-presets/templates/parts/buyer-entry.hbs" this}}{{/each}}
    {{/if}}
  {{else}}
    {{#each buyerPicker.actors}}{{> "modules/merchant-presets/templates/parts/buyer-entry.hbs" this}}{{/each}}
  {{/if}}
</div>

<nav class="mp-tabs sheet-tabs tabs" data-group="primary" data-pen="Tabs">
  {{#each tabs}}
    <button type="button" class="mp-tab tab-link {{cssClass}}" data-action="tab" data-group="primary" data-tab="{{id}}" data-pen="Tab {{localize label}}">
      {{mpIcon icon pen=(concat (localize label) " icon")}}<span data-pen="{{localize label}} label">{{localize label}}</span>
      {{#if gm}}<span class="mp-gm-badge" data-pen="GM badge"><span data-pen="GM badge text">{{localize "MERCHANT_PRESETS.Shop.Tabs.GmBadge"}}</span></span>{{/if}}
    </button>
  {{/each}}
</nav>

<section class="tab buy-tab {{#if (eq kind "buy")}}active{{/if}}" data-group="primary" data-tab="buy" data-pen="Body">
  <nav class="mp-categories" data-pen="Categories">{{> mpCategoryLinks categories=buy.categories kind="buy"}}</nav>
  <div class="mp-stock shop-stock {{#unless open}}is-closed{{/unless}}" data-pen="Stock">
    {{#each buy.sections}}
      <div class="mp-group" data-pen="Group {{pen}}">
        <h2 class="mp-group-heading" data-pen="{{pen}} heading">{{label}}</h2><span class="mp-rule" data-pen="{{pen}} rule"></span>
      </div>
      {{#each rows}}
        <div class="mp-row {{#if (eq stock.state 'soldOut')}}is-sold-out{{/if}} {{#if inBasket}}in-basket{{/if}}" data-pen="Row {{name}}">
          <img class="mp-item-icon" src="{{img}}" alt="" data-pen="Item Icon" />
          <div class="mp-row-text" data-pen="Text">
            <span class="mp-name-line" data-pen="Name line">
              <span data-pen="Name" data-tooltip="{{name}}">{{name}}</span>
              {{#if isNew}}<span class="mp-new-badge" data-pen="New badge"><span data-pen="New badge text">{{localize "MERCHANT_PRESETS.Shop.Tag.New"}}</span></span>{{/if}}
            </span>
            <span class="mp-meta" data-pen="Meta">{{meta}}</span>
          </div>
          <span class="mp-stock-state is-{{stock.state}}" data-pen="Stock">
            {{#if (eq stock.state "count")}}{{localize "MERCHANT_PRESETS.Shop.Stock.Left" count=stock.count}}
            {{else if (eq stock.state "last")}}{{localize "MERCHANT_PRESETS.Shop.Stock.Last"}}
            {{else if (eq stock.state "soldOut")}}{{localize "MERCHANT_PRESETS.Shop.Stock.SoldOut"}}
            {{else}}{{localize "MERCHANT_PRESETS.Shop.Stock.Always"}}{{/if}}
          </span>
          <div class="mp-price-block" data-pen="Price Block">
            {{#if (or unpriced worthless)}}
              <span class="price-worthless">{{localize "MERCHANT_PRESETS.Shop.Worthless"}}</span>
            {{else}}
              {{#if listText}}<s class="mp-list-price" data-pen="List Price" data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Deal.ListPrice'}}">{{listText}}</s>{{/if}}
              <span class="mp-price-line" data-pen="Price Line">
                {{#if service}}<span class="mp-tag is-ratio" data-pen="Terms Tag"><span data-pen="Terms Tag Text">{{localize "MERCHANT_PRESETS.Shop.Tag.Service"}}</span></span>{{/if}}
                {{#if tag.text}}<span class="mp-tag is-good price-tag tag-{{tag.kind}}" data-pen="Terms Tag" {{#if (eq tag.kind "deal")}}data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Deal.Yours'}}"{{/if}}><span data-pen="Terms Tag Text">{{tag.text}}</span></span>{{/if}}
                {{#if (eq tag.kind "full")}}<span class="price-tag tag-full">{{localize "MERCHANT_PRESETS.Shop.Tag.Full"}}</span>{{/if}}
                {{#if (gt bundle 1)}}<span class="price-tag tag-neutral">{{localize "MERCHANT_PRESETS.Shop.Tag.Bundle" bundle=bundle}}</span>{{/if}}
                {{#if priceFor}}<span class="price-tag tag-neutral">{{localize "MERCHANT_PRESETS.Shop.Tag.PriceFor" count=priceFor}}</span>{{/if}}
                {{> mpCoins coins=priceCoins mode="price"}}
              </span>
            {{/if}}
          </div>
          {{!-- A sold-out line has nothing to add (design: the Shield row), and a closed shop nothing at
                all (x9IX9); the rows stay, to look over. --}}
          {{#if (and ../../open (not (eq stock.state "soldOut")))}}
            <button type="button" class="mp-add" data-action="addLine" data-item-id="{{id}}" data-pen="Add"
              aria-label="{{localize 'MERCHANT_PRESETS.Shop.Buy.AddToBill'}}"
              {{#if (or unpriced worthless)}}disabled{{/if}}>
              {{mpIcon "plus" pen="Add icon"}}
            </button>
          {{/if}}
        </div>
      {{/each}}
    {{else}}
      <p class="shop-empty">{{localize "MERCHANT_PRESETS.Shop.Buy.Empty"}}</p>
    {{/each}}
  </div>
  {{#if buy.showClosed}}
    {{> "modules/merchant-presets/templates/parts/closed-card.hbs" closed}}
  {{else}}
    {{> "modules/merchant-presets/templates/parts/bill-of-sale.hbs" buy}}
  {{/if}}
</section>

<section class="tab sell-tab {{#if (eq kind "sell")}}active{{/if}}" data-group="primary" data-tab="sell" data-pen="Body">
  <nav class="mp-categories" data-pen="Categories">
    {{!-- The till caps what a sale can bring in; under unlimited merchant coin there is none to show. --}}
    {{#if sell.tillCapsSales}}
      <div class="mp-till-card" data-pen="Till Card">
        <span class="mp-till-kicker" data-pen="Till kicker">{{localize "MERCHANT_PRESETS.Shop.Sell.Till"}}</span>
        <div class="mp-till-coins" data-pen="Till coins">{{> mpCoins coins=sell.tillCoins mode="count"}}</div>
        <span class="mp-meter" data-pen="Till meter"><span class="mp-meter-used" data-pen="Till used" style="width: {{sell.meterPercent}}%"></span></span>
        <p class="mp-till-note" data-pen="Till note">{{localize "MERCHANT_PRESETS.Shop.Sell.TillNote"}}</p>
      </div>
    {{/if}}
    {{#if sell.packLabel}}<span class="mp-pack-label" data-pen="Pack label">{{sell.packLabel}}</span>{{/if}}
    {{> mpCategoryLinks categories=sell.categories kind="sell"}}
  </nav>
  <div class="mp-stock sell-stock {{#unless sell.open}}is-closed{{/unless}}" data-pen="Stock">
    {{#each sell.sections}}
      <div class="mp-group" data-pen="Group {{pen}}">
        <h2 class="mp-group-heading" data-pen="{{pen}} heading">{{label}}</h2><span class="mp-rule" data-pen="{{pen}} rule"></span>
      </div>
      {{#each rows}}
        {{#if refusal}}
          {{!-- A good the shop won't take stays in its group, with the reason; an unidentified one
                isn't turned away for good, so it keeps full strength, in amber. --}}
          <div class="mp-row {{#unless (eq refusal 'Unidentified')}}is-refused{{/unless}}" data-pen="Refused {{name}}">
            <img class="mp-item-icon" src="{{img}}" alt="" data-pen="Item Icon" />
            <div class="mp-row-text" data-pen="Text">
              <span class="mp-name-line" data-pen="Name line"><span data-pen="Name" data-tooltip="{{name}}">{{name}}</span></span>
              <span class="mp-meta" data-pen="Meta">{{meta}}</span>
            </div>
            <span class="mp-stock-state is-{{#if (eq refusal 'Unidentified')}}unidentified{{else}}soldOut{{/if}}" data-pen="Stock">{{reason}}</span>
          </div>
        {{else}}
          <div class="mp-row" data-pen="Sell {{name}}">
            <img class="mp-item-icon" src="{{img}}" alt="" data-pen="Item Icon" />
            <div class="mp-row-text" data-pen="Text">
              <span class="mp-name-line" data-pen="Name line">
                <span data-pen="Name" data-tooltip="{{name}}">{{name}}</span>
                {{#if equipped}}{{mpIcon "shield-half" pen="Equipped icon"}}{{/if}}
              </span>
              <span class="mp-meta" data-pen="Meta">{{meta}}</span>
            </div>
            <span class="mp-stock-state" data-pen="Stock">×{{owned}}</span>
            <div class="mp-price-block" data-pen="Price Block">
              {{#if listText}}<s class="mp-list-price" data-pen="List Price" data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Deal.ListPrice'}}">{{listText}}</s>{{/if}}
              <span class="mp-price-line" data-pen="Price Line">
                {{#if tag.text}}<span class="mp-tag is-good" data-pen="Terms Tag" data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Deal.Yours'}}"><span data-pen="Terms Tag Text">{{tag.text}}</span></span>
                {{else}}<span class="mp-tag is-ratio" data-pen="Terms Tag"><span data-pen="Terms Tag Text">{{ratio}}</span></span>{{/if}}
                {{#if (gt bundle 1)}}<span class="price-tag tag-neutral">{{localize "MERCHANT_PRESETS.Shop.Tag.Bundle" bundle=bundle}}</span>{{/if}}
                {{#if priceFor}}<span class="price-tag tag-neutral">{{localize "MERCHANT_PRESETS.Shop.Tag.PriceFor" count=priceFor}}</span>{{/if}}
                {{> mpCoins coins=priceCoins mode="price"}}
              </span>
            </div>
            {{#if ../../sell.open}}
              <button type="button" class="mp-add" data-action="addLine" data-item-id="{{id}}" data-pen="Add"
                aria-label="{{localize 'MERCHANT_PRESETS.Shop.Buy.AddToBill'}}">
                {{mpIcon "plus" pen="Add icon"}}
              </button>
            {{/if}}
          </div>
        {{/if}}
      {{/each}}
    {{/each}}
    {{#if sell.empty}}
      <p class="shop-empty">{{localize "MERCHANT_PRESETS.Shop.Sell.Empty"}}</p>
    {{/if}}
  </div>
  {{#if sell.showClosed}}
    {{> "modules/merchant-presets/templates/parts/closed-card.hbs" closed}}
  {{else}}
    {{> "modules/merchant-presets/templates/parts/bill-of-sale.hbs" sell}}
  {{/if}}
</section>

{{#if settings}}
  <section class="tab settings-tab {{#if (eq kind "settings")}}active{{/if}}" data-group="primary" data-tab="settings" data-pen="Body">
    {{> "modules/merchant-presets/templates/parts/settings-tab.hbs" settings}}
  </section>
{{/if}}
