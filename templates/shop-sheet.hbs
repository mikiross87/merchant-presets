{{!-- The shop window (#103), built to design/shop.pen's frames (#145): every element the design
      draws carries its layer name as `data-pen`, which tools/design-check.mjs pairs with the
      frame's node of that name. One root template: every tab's markup is always in the DOM (see
      shop-sheet.mjs's _prepareContext comment), and core's native changeTab() toggles which
      .tab[data-tab] section is visible. --}}

{{!-- Coins, the amount before each glyph: `this` is a coinBreakdown() array. --}}
{{#*inline "coins"}}
  {{#each this}}
    <span class="coin coin-{{denomination}}" data-tooltip="{{aria}}" aria-label="{{aria}}">
      <img src="{{icon}}" alt="" />
      <b>{{count}}</b>
    </span>
  {{else}}
    <span class="coin coin-free">{{localize "MERCHANT_PRESETS.Shop.Free"}}</span>
  {{/each}}
{{/inline}}
{{!-- The design's coins: `coins` a coinBreakdown() array, `mode` how each is named (mpCoinPen). --}}
{{#*inline "mpCoins"}}
  {{#each coins}}
    <span class="mp-coin coin-{{denomination}}" data-pen="{{mpCoinPen ../mode this @index}}" data-tooltip="{{aria}}" aria-label="{{aria}}">
      <b data-pen="Amount">{{count}}</b><img data-pen="Coin" src="{{icon}}" alt="" />
    </span>
  {{else}}
    <span class="coin coin-free">{{localize "MERCHANT_PRESETS.Shop.Free"}}</span>
  {{/each}}
{{/inline}}

<header class="mp-hero" data-pen="Hero">
  <img class="mp-portrait" data-pen="Merchant Portrait" src="{{header.img}}" alt="" />
  <div class="mp-identity" data-pen="Identity">
    <div class="mp-title-line" data-pen="Title line">
      <h1 class="mp-shop-name" data-pen="Shop Name">{{header.title}}</h1>
    </div>
    {{!-- The shop's own #98 description; shipped shops carry it as HTML (a <p> of its own), so
          this renders it unescaped, after the sheet has run it through foundry.utils.cleanHTML. --}}
    <div class="mp-description" data-pen="Shop Description">{{{header.description}}}</div>
    <div class="mp-chips" data-pen="Chips">
      <span class="mp-hero-chip mp-open-chip {{#if header.open}}is-open{{else}}is-closed{{/if}}" data-pen="Open Chip">
        <span class="mp-dot" data-pen="Dot"></span><span data-pen="Open Label">{{header.openLabel}}</span>
      </span>
      <span class="mp-hero-chip" data-pen="Kind Chip">
        {{mpIcon header.kindIcon pen="Kind icon"}}<span data-pen="Kind Label">{{header.tier}}</span>
      </span>
      <button type="button" class="mp-hero-chip mp-terms-chip chip-terms" data-pen="Terms Chip" popovertarget="{{appId}}-terms-popover">
        {{mpIcon "scale" pen="Terms icon"}}<span data-pen="Terms Label">{{header.termsChip}}</span>{{mpIcon "chevron-down" pen="Terms chevron"}}
      </button>
    </div>
  </div>
  <div class="mp-purse" data-pen="Purse">
    <span class="mp-purse-label" data-pen="Purse Label">{{localize "MERCHANT_PRESETS.Shop.BuyingAs"}}</span>
    <button type="button" class="mp-buyer-row buying-as-toggle" data-pen="Buyer row" popovertarget="{{appId}}-buyer-picker">
      {{#if buyer}}<span class="mp-buyer-avatar" data-pen="Buyer avatar"><span data-pen="Buyer initial">{{buyerInitial}}</span></span>{{/if}}
      <span class="mp-buyer-name" data-pen="Buyer name">{{#if buyer}}{{buyer.name}}{{else}}{{localize "MERCHANT_PRESETS.Shop.NoBuyer"}}{{/if}}</span>
      {{mpIcon "chevron-down" pen="Buyer chevron"}}
    </button>
    {{#if buyer}}
      <div class="mp-purse-coins" data-pen="Purse Coins">{{> mpCoins coins=buyerPurse mode="metal"}}</div>
    {{/if}}
  </div>
</header>

<div id="{{appId}}-terms-popover" popover class="shop-popover terms-popover">
  <h2><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i> {{localize "MERCHANT_PRESETS.Shop.Terms.Title"}}</h2>
  <p class="term-line"><i class="fa-solid fa-arrow-up-right" aria-hidden="true"></i>
    {{localize "MERCHANT_PRESETS.Shop.Terms.SellsAt"}} <b>{{header.terms.sellsAtLabel}}</b>
  </p>
  <p class="term-note">{{localize "MERCHANT_PRESETS.Shop.Terms.ExampleSells"}} {{> coins header.terms.exampleSell}}.</p>
  <p class="term-line"><i class="fa-solid fa-arrow-down-left" aria-hidden="true"></i>
    {{localize "MERCHANT_PRESETS.Shop.Terms.BuysAt"}} <b>{{header.terms.buysAtLabel}}</b>
  </p>
  <p class="term-note">{{localize "MERCHANT_PRESETS.Shop.Terms.ExampleBuys"}} {{> coins header.terms.exampleBuy}}.</p>
  {{#if header.terms.hasWontBuy}}
    <p class="term-line"><i class="fa-solid fa-ban" aria-hidden="true"></i>
      {{localize "MERCHANT_PRESETS.Shop.Terms.WontBuy"}}
      <b>{{#each header.terms.wontBuyTypes}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{#each header.terms.wontBuyKinds}}{{#if @first}}{{#if ../header.terms.wontBuyTypes.length}}, {{/if}}{{/if}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</b>
    </p>
  {{/if}}
  {{#each header.terms.categories}}
    <p class="term-line term-line-category"><i class="fa-solid fa-tags" aria-hidden="true"></i>
      {{this.category}}: {{this.sellsAt}}× / {{this.buysAt}}×
    </p>
  {{/each}}
  <p class="term-footnote">{{localize "MERCHANT_PRESETS.Shop.Terms.Note"}}</p>
</div>

<div id="{{appId}}-buyer-picker" popover class="shop-popover buyer-picker">
  {{#if buyerPicker.gm}}
    <p class="picker-hint">{{localize "MERCHANT_PRESETS.Shop.BuyerPicker.GmHint"}}</p>
    <input type="search" class="buyer-search" id="{{appId}}-buyer-search" placeholder="{{localize 'MERCHANT_PRESETS.Shop.BuyerPicker.Search'}}" />
    {{#if buyerPicker.characters.length}}
      <h3>{{localize "MERCHANT_PRESETS.Shop.BuyerPicker.PlayerCharacters"}}</h3>
      {{#each buyerPicker.characters}}{{> "modules/merchant-presets/templates/parts/buyer-entry.hbs" this}}{{/each}}
    {{/if}}
    {{#if buyerPicker.others.length}}
      <h3>{{localize "MERCHANT_PRESETS.Shop.BuyerPicker.OtherActors"}}</h3>
      {{#each buyerPicker.others}}{{> "modules/merchant-presets/templates/parts/buyer-entry.hbs" this}}{{/each}}
    {{/if}}
  {{else}}
    <p class="picker-hint">{{localize "MERCHANT_PRESETS.Shop.BuyerPicker.PlayerHint"}}</p>
    {{#each buyerPicker.actors}}{{> "modules/merchant-presets/templates/parts/buyer-entry.hbs" this}}{{/each}}
  {{/if}}
</div>

<nav class="mp-tabs sheet-tabs tabs" data-group="primary" data-pen="Tabs">
  {{#each tabs}}
    <button type="button" class="mp-tab tab-link {{cssClass}}" data-action="tab" data-group="primary" data-tab="{{id}}" data-pen="Tab {{localize label}}">
      {{mpIcon icon pen=(concat (localize label) " icon")}}<span data-pen="{{localize label}} label">{{localize label}}</span>
      {{#if gm}}<span class="mp-gm-badge" data-pen="GM badge"><span data-pen="GM badge text">{{localize "MERCHANT_PRESETS.Shop.Tabs.GmBadge"}}</span></span>{{/if}}
    </button>
  {{/each}}
</nav>

<section class="tab buy-tab {{#if (eq kind "buy")}}active{{/if}}" data-group="primary" data-tab="buy">
  <nav class="shop-categories">
    {{#each buy.categories}}
      <button type="button" class="category-link {{#if active}}active{{/if}}" data-action="selectCategory" data-category="{{id}}">
        {{#if (eq id "all")}}{{localize "MERCHANT_PRESETS.Shop.Category.All"}}{{else}}{{label}}{{/if}}
        <span class="category-count">{{count}}</span>
      </button>
    {{/each}}
  </nav>
  <div class="shop-stock">
    {{#each buy.sections}}
      <h2 class="stock-section-header">{{categoryLabel}}</h2>
      {{#each rows}}
        <div class="item-row {{#if (eq stock.state 'soldOut')}}is-sold-out{{/if}} {{#unless ../../open}}is-dimmed{{/unless}} {{#if inBasket}}in-basket{{/if}}">
          <img class="item-art" src="{{img}}" alt="" />
          <div class="item-info">
            <span class="item-name">{{name}}{{#if isNew}}<span class="badge-new">{{localize "MERCHANT_PRESETS.Shop.Tag.New"}}</span>{{/if}}</span>
            <span class="item-meta">{{categoryLabel}}</span>
          </div>
          <span class="item-stock {{#if (eq stock.state 'soldOut')}}is-sold-out{{/if}} {{#if (eq stock.state 'last')}}is-last{{/if}}">
            {{#if (eq stock.state "count")}}{{localize "MERCHANT_PRESETS.Shop.Stock.Left" count=stock.count}}
            {{else if (eq stock.state "last")}}{{localize "MERCHANT_PRESETS.Shop.Stock.Last"}}
            {{else if (eq stock.state "soldOut")}}{{localize "MERCHANT_PRESETS.Shop.Stock.SoldOut"}}
            {{else}}{{localize "MERCHANT_PRESETS.Shop.Stock.Always"}}{{/if}}
          </span>
          <div class="item-price">
            {{#if (or unpriced worthless)}}
              <span class="price-worthless">{{localize "MERCHANT_PRESETS.Shop.Worthless"}}</span>
            {{else}}
              {{#if service}}<span class="price-tag tag-neutral">{{localize "MERCHANT_PRESETS.Shop.Tag.Service"}}</span>{{/if}}
              {{#if tag.text}}<span class="price-tag tag-{{tag.kind}}" {{#if (eq tag.kind "deal")}}data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Deal.Yours'}}"{{/if}}>{{tag.text}}</span>{{/if}}
              {{#if (eq tag.kind "full")}}<span class="price-tag tag-full">{{localize "MERCHANT_PRESETS.Shop.Tag.Full"}}</span>{{/if}}
              {{#if (gt bundle 1)}}<span class="price-tag tag-neutral">{{localize "MERCHANT_PRESETS.Shop.Tag.Bundle" bundle=bundle}}</span>{{/if}}
              {{#if priceFor}}<span class="price-tag tag-neutral">{{localize "MERCHANT_PRESETS.Shop.Tag.PriceFor" count=priceFor}}</span>{{/if}}
              <span class="price-stack">{{#if listText}}<s class="price-list" data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Deal.ListPrice'}}">{{listText}}</s>{{/if}}<span class="price-coins">{{> coins priceCoins}}</span></span>
            {{/if}}
          </div>
          <button type="button" class="item-add" data-action="addLine" data-item-id="{{id}}"
            aria-label="{{localize 'MERCHANT_PRESETS.Shop.Buy.AddToBill'}}"
            {{#if (or unpriced worthless)}}disabled{{/if}} {{#unless ../../open}}disabled{{/unless}} {{#if (eq stock.state 'soldOut')}}disabled{{/if}}>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
        </div>
      {{/each}}
    {{else}}
      <p class="shop-empty">{{localize "MERCHANT_PRESETS.Shop.Buy.Empty"}}</p>
    {{/each}}
  </div>
  {{#if buy.showClosed}}
    {{> "modules/merchant-presets/templates/parts/closed-card.hbs" closed}}
  {{else}}
    {{> "modules/merchant-presets/templates/parts/bill-of-sale.hbs" buy}}
  {{/if}}
</section>

<section class="tab sell-tab {{#if (eq kind "sell")}}active{{/if}}" data-group="primary" data-tab="sell">
  <aside class="sell-side-card">
    <p class="sell-ratio-label">{{localize "MERCHANT_PRESETS.Shop.Sell.BuysAt"}}</p>
    <p class="sell-ratio">{{sell.ratioLabel}} <span class="sell-ratio-of">{{localize "MERCHANT_PRESETS.Shop.Sell.OfValue"}}</span></p>
    {{#if sell.tillCapsSales}}<p class="sell-till-note">{{localize "MERCHANT_PRESETS.Shop.Sell.TillHolds" amount=sell.tillText}}</p>{{/if}}
  </aside>
  <div class="sell-rows">
    {{#if sell.willBuy.length}}
      <h2 class="stock-section-header">{{localize "MERCHANT_PRESETS.Shop.Sell.WillBuy"}}</h2>
      {{#each sell.willBuy}}
        <div class="item-row {{#unless ../sell.open}}is-dimmed{{/unless}}">
          <img class="item-art" src="{{img}}" alt="" />
          <div class="item-info">
            <span class="item-name">{{name}}{{#if equipped}}<i class="fa-solid fa-shield-halved item-equipped" data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Sell.Equipped'}}"></i>{{/if}}</span>
            <span class="item-meta">×{{owned}}</span>
          </div>
          <span class="price-tag tag-neutral">{{ratio}}</span>
          {{!-- One grid cell, as on the Buy row: the row's grid has five columns whatever tags show. --}}
          <div class="item-price">
            {{#if tag.text}}<span class="price-tag tag-deal" data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Deal.Yours'}}">{{tag.text}}</span>{{/if}}
            {{#if (gt bundle 1)}}<span class="price-tag tag-neutral">{{localize "MERCHANT_PRESETS.Shop.Tag.Bundle" bundle=bundle}}</span>{{/if}}
            {{#if priceFor}}<span class="price-tag tag-neutral">{{localize "MERCHANT_PRESETS.Shop.Tag.PriceFor" count=priceFor}}</span>{{/if}}
            <span class="price-stack">{{#if listText}}<s class="price-list" data-tooltip="{{localize 'MERCHANT_PRESETS.Shop.Deal.ListPrice'}}">{{listText}}</s>{{/if}}<span class="price-coins">{{> coins priceCoins}}</span></span>
          </div>
          <button type="button" class="item-add" data-action="addLine" data-item-id="{{id}}"
            aria-label="{{localize 'MERCHANT_PRESETS.Shop.Buy.AddToBill'}}" {{#unless ../sell.open}}disabled{{/unless}}>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
        </div>
      {{/each}}
    {{/if}}
    {{#if sell.wontBuy.length}}
      <h2 class="stock-section-header">{{localize "MERCHANT_PRESETS.Shop.Sell.WontBuy"}}</h2>
      {{#each sell.wontBuy}}
        <div class="item-row is-refused">
          <img class="item-art" src="{{img}}" alt="" />
          <div class="item-info">
            <span class="item-name">{{name}}</span>
            {{#if (eq refusal "Unidentified")}}
              <span class="item-meta">{{localize "MERCHANT_PRESETS.Shop.Sell.Reason.UnidentifiedNote"}}</span>
            {{/if}}
          </div>
          <span class="refusal-reason refusal-{{refusal}}">
            {{localize (concat "MERCHANT_PRESETS.Shop.Sell.Reason." refusal)}}
          </span>
        </div>
      {{/each}}
    {{/if}}
    {{#unless sell.willBuy.length}}{{#unless sell.wontBuy.length}}
      <p class="shop-empty">{{localize "MERCHANT_PRESETS.Shop.Sell.Empty"}}</p>
    {{/unless}}{{/unless}}
  </div>
  {{#if sell.showClosed}}
    {{> "modules/merchant-presets/templates/parts/closed-card.hbs" closed}}
  {{else}}
    {{> "modules/merchant-presets/templates/parts/bill-of-sale.hbs" sell}}
  {{/if}}
</section>

{{#if settings}}
  <section class="tab settings-tab {{#if (eq kind "settings")}}active{{/if}}" data-group="primary" data-tab="settings" data-pen="Body">
    {{> "modules/merchant-presets/templates/parts/settings-tab.hbs" settings}}
  </section>
{{/if}}
